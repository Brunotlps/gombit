# Project choices recorded by `gombit new`. Runtime configuration is read
# from the process environment (see .env.example), not this file.
name: {{.Name}}
module: {{.Module}}
database: {{.Database}}
cache: {{.Cache}}
# Bearer JWT is the v0.1 API default (C3). Cookie/CSRF lands in M5-3;
# this field records the choice only.
auth: {{.Auth}}
# Minimal/headless is the default (C4). `--ui mui` records MUI; the MUI
# CRUD preset lands in M5-4.
ui: {{.UI}}
api_prefix: {{.APIPrefix}}
