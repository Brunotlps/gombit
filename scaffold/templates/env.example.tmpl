# Server configuration. Copy to `.env` and fill in local values.
# Do not commit real secrets. Runtime reads these via config.Load().

GOMBIT_APP_NAME={{.Name}}
GOMBIT_ENV=development
GOMBIT_HTTP_ADDR=:8080
GOMBIT_HTTP_REQUEST_TIMEOUT=60s
GOMBIT_API_PREFIX={{.APIPrefix}}
GOMBIT_DOCS_ENABLED=true
GOMBIT_DATABASE_DRIVER={{.Database}}
GOMBIT_DATABASE_DSN={{.DatabaseDSN}}
GOMBIT_CACHE_DRIVER={{.Cache}}
GOMBIT_CACHE_NAMESPACE={{.CacheNamespace}}
GOMBIT_REDIS_ADDR=127.0.0.1:6379
GOMBIT_REDIS_USERNAME=
GOMBIT_REDIS_PASSWORD=
GOMBIT_REDIS_DB=0
GOMBIT_REDIS_DIAL_TIMEOUT=5s
GOMBIT_REDIS_READ_TIMEOUT=3s
GOMBIT_REDIS_WRITE_TIMEOUT=3s
GOMBIT_REDIS_TLS=false
GOMBIT_REDIS_TLS_INSECURE=false
GOMBIT_LOG_LEVEL=info
GOMBIT_LOG_SINK=stderr

# HMAC secret shared by Bearer access JWTs and (in cookie mode) the CSRF
# double-submit signature. This development placeholder is shorter than 32
# characters and is rejected in production (Appendix C). `gombit new` also
# writes a gitignored `.env` with a per-project random secret. Never put
# this in VITE_*.
GOMBIT_JWT_SECRET=dev-only-not-for-production
GOMBIT_JWT_ACCESS_TTL=15m
GOMBIT_JWT_REFRESH_TTL=168h
{{if eq .Auth "cookie"}}
# Cookie/session + CSRF (M5-3). See docs/auth-cookie.md for the threat
# model. GOMBIT_COOKIE_SECURE must be true in production (Appendix C);
# config.Load / gombit doctor fail loud otherwise.
GOMBIT_AUTH_MODE=cookie
GOMBIT_COOKIE_SECURE=true
GOMBIT_COOKIE_SAMESITE=lax
{{end}}
# Public frontend values. Every VITE_* variable is inlined into the browser
# bundle — never put secrets or JWT material here.
# Empty means same-origin (Vite proxies /api during `gombit dev`). For a split
# deploy, set the API origin only. OpenAPI path keys stay /api/v1; the SPA
# rewrites them to GOMBIT_API_PREFIX at request time (not baked at gombit new).
VITE_API_URL=
