# BENCH-1 Laravel app (issue #141). Copy to .env and set APP_KEY
# (`php artisan key:generate`). .env is gitignored; this template is the
# documented, committed default. Production run: APP_ENV=production,
# APP_DEBUG=false (issue #141 §17).
APP_NAME=GombitBenchLaravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8084

# issue #141 §19: no per-request access logging during a benchmark run.
# Laravel does not log a line per request by default (unlike Rails' scaffold),
# so there is no request logger to disable here; LOG_LEVEL=warning keeps the
# app log to warnings/errors, and the nginx access log is turned off in the
# documented production vhost (see README).
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# PostgreSQL via the suite-standard DATABASE_URL (config/database.php's pgsql
# connection reads it). DB_CONNECTION selects that connection.
DB_CONNECTION=pgsql
DATABASE_URL=postgres://gombit:gombit@127.0.0.1:55432/gombit_bench_laravel?sslmode=disable

# No sessions, cache tables, or queued jobs in this API benchmark: array/sync
# drivers keep the schema to the canonical users/projects only (no extra
# sessions/cache/jobs tables) and add no per-request session or cache-store
# overhead.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12
