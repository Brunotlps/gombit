source "https://rubygems.org"

# Pinned exact versions (issue #141 §16/§17): every implementation pins its
# dependencies so a benchmark run is reproducible. Upgrade deliberately, not
# via a floating range — unlike this Gemfile's rails-new-generated default
# ("~> 8.1.3", ">= 8.1.3.1"), which still floats within 8.1.x.
gem "rails", "8.1.3.1"
gem "pg", "1.6.3"
gem "puma", "8.0.2"

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
end
