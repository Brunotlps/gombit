{
  "components": {
    "schemas": {
      "CreateWidgetBody": {
        "additionalProperties": false,
        "properties": {
          "color": {
            "description": "Optional display color",
            "examples": [
              "green"
            ],
            "maxLength": 30,
            "type": "string"
          },
          "name": {
            "description": "Human-readable widget name",
            "examples": [
              "Second widget"
            ],
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "SuccessEnvelopeListWidget": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Widget"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "SuccessEnvelopeWidget": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Widget"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "Widget": {
        "additionalProperties": false,
        "properties": {
          "color": {
            "description": "Optional display color",
            "examples": [
              "blue"
            ],
            "type": "string"
          },
          "id": {
            "description": "Stable widget identifier",
            "examples": [
              "widget-1"
            ],
            "type": "string"
          },
          "name": {
            "description": "Human-readable widget name",
            "examples": [
              "First widget"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Gombit Contract Spike",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/widgets": {
      "get": {
        "operationId": "list-widgets",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelopeListWidget"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List widgets",
        "tags": [
          "Widgets"
        ]
      },
      "post": {
        "operationId": "create-widget",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWidgetBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelopeWidget"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Create a widget",
        "tags": [
          "Widgets"
        ]
      }
    }
  }
}
